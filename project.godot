; Monster Garden — Godot 4.3, portrait, Mobile renderer.
config_version=5

[application]
config/name="Monster Garden"
config/description="Cultivate the beautifully strange."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/icon.svg"

[autoload]
Catalog="*res://scripts/data/Catalog.gd"
Events="*res://scripts/core/Events.gd"
LevelXP="*res://scripts/core/LevelXP.gd"
UnlockManager="*res://scripts/core/UnlockManager.gd"
Inventory="*res://scripts/core/Inventory.gd"
Economy="*res://scripts/core/Economy.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
AssetFactory="*res://scripts/art/AssetFactory.gd"
Game="*res://scripts/core/Game.gd"
BuyerOrders="*res://scripts/core/BuyerOrders.gd"
Breeding="*res://scripts/core/Breeding.gd"
DiscoveryRewards="*res://scripts/core/DiscoveryRewards.gd"

QuestManager="*res://scripts/core/QuestManager.gd"

OfflineProgression="*res://scripts/core/OfflineProgression.gd"
Notifications="*res://scripts/core/Notifications.gd"

Premium="*res://scripts/core/Premium.gd"
IAPService="*res://scripts/core/IAPService.gd"

[display]
window/size/viewport_width=480
window/size/viewport_height=900
window/size/window_width_override=480
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.07, 0.085, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false
